{
  "version": 1,
  "description": "Phase 1 benchmark baseline — update intentionally when optimizations land.",
  "targets": {
    "joinTimeMs": { "max": 5000, "unit": "ms" },
    "iceTimeMs": { "max": 8000, "unit": "ms" },
    "firstAudioMs": { "max": 3000, "unit": "ms" },
    "firstVideoMs": { "max": 6000, "unit": "ms" },
    "reconnectCount": { "max": 2, "unit": "count" },
