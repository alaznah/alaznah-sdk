+- (void)alaznahUpdateNativeAvatarInFallback:(NSString *)initials accent:(UIColor *)accentColor {
+    const NSInteger tag = 424242;
+    UIView *existing = [_fallbackView viewWithTag:tag];
+    [existing removeFromSuperview];
+    NSString *labelText = initials.length > 0 ? initials : @"?";
+    if (labelText.length > 2) {
+        labelText = [labelText substringToIndex:2];
+    }
+    UIView *host = [[UIView alloc] initWithFrame:CGRectZero];
+    host.tag = tag;
+    host.translatesAutoresizingMaskIntoConstraints = NO;
+    host.backgroundColor = [UIColor clearColor];
+    UILabel *label = [[UILabel alloc] initWithFrame:CGRectZero];
+    label.translatesAutoresizingMaskIntoConstraints = NO;
+    label.text = [labelText uppercaseString];
+    label.textColor = accentColor;
+    label.textAlignment = NSTextAlignmentCenter;
+    label.font = [UIFont systemFontOfSize:42 weight:UIFontWeightBold];
+    label.backgroundColor = [[UIColor blackColor] colorWithAlphaComponent:0.45];
+    label.clipsToBounds = YES;
+    [_fallbackView addSubview:host];
+    [host addSubview:label];
+    [NSLayoutConstraint activateConstraints:@[
+        [host.leadingAnchor constraintEqualToAnchor:_fallbackView.leadingAnchor],
+        [host.trailingAnchor constraintEqualToAnchor:_fallbackView.trailingAnchor],
+        [host.topAnchor constraintEqualToAnchor:_fallbackView.topAnchor],
+        [host.bottomAnchor constraintEqualToAnchor:_fallbackView.bottomAnchor],
+        [label.centerXAnchor constraintEqualToAnchor:host.centerXAnchor],
+        [label.centerYAnchor constraintEqualToAnchor:host.centerYAnchor],
+        [label.widthAnchor constraintEqualToAnchor:host.widthAnchor multiplier:0.42],
+        [label.heightAnchor constraintEqualToAnchor:label.widthAnchor],
+    ]];
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [host layoutIfNeeded];
+        label.layer.cornerRadius = label.bounds.size.width / 2.0;
+    });
+}
+
+- (UIColor *)alaznahColorFromCSS:(NSString *)css {
+    NSString *hex = [[css stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] uppercaseString];
+    if ([hex hasPrefix:@"#"]) {
+        hex = [hex substringFromIndex:1];
+    }
+    if (hex.length == 3) {
+        unichar r = [hex characterAtIndex:0];
+        unichar g = [hex characterAtIndex:1];
+        unichar b = [hex characterAtIndex:2];
+        hex = [NSString stringWithFormat:@"%C%C%C%C%C%C", r, r, g, g, b, b];
+    }
+    if (hex.length != 6) {
+        return nil;
+    }
+    unsigned int value = 0;
+    NSScanner *scanner = [NSScanner scannerWithString:hex];
+    if (![scanner scanHexInt:&value]) {
+        return nil;
+    }
+    return [UIColor colorWithRed:((value >> 16) & 0xFF) / 255.0
+                           green:((value >> 8) & 0xFF) / 255.0
+                            blue:(value & 0xFF) / 255.0
+                           alpha:1.0];
+}
