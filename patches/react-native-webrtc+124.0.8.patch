+- (void)tryStartPIPAttempt:(NSInteger)attempt {
+    if (!_pipController) {
+        NSLog(@"[AlaznahPIP] tryStart abort — controller nil");
+        return;
+    }
+    if (_pipController.isPictureInPictureActive) {
+        NSLog(@"[AlaznahPIP] tryStart already active");
+        return;
+    }
+    [self logPipState:[NSString stringWithFormat:@"tryStart attempt=%ld", (long)attempt]];
     if (_pipController.isPictureInPicturePossible) {
+        NSLog(@"[AlaznahPIP] startPictureInPicture");
         [_pipController startPictureInPicture];
+        return;
+    }
+    if (attempt >= 15) {
+        UIView *src = self.sourceView;
+    NSLog(@"[PIP_FAILED] giving up isPictureInPicturePossible=NO source.window=%p key=%d",
+          src.window,
+          src.window.isKeyWindow);
+        [[NSNotificationCenter defaultCenter] postNotificationName:@"AlaznahWebRTCPipFailed"
+                                                            object:nil
+                                                          userInfo:@{ @"error" : @"isPictureInPicturePossible=NO" }];
+        [[NSNotificationCenter defaultCenter] postNotificationName:@"AlaznahWebRTCPipDidStop" object:nil];
+        return;
     }
+    __weak PIPController *weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        [weakSelf tryStartPIPAttempt:attempt + 1];
