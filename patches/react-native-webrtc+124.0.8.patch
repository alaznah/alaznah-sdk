+- (void)layoutLocalInset {
+    if (!_localInsetContainer || !_pipCallViewController.view) {
+        return;
+    }
+    UIView *host = _pipCallViewController.view;
+    CGFloat hostW = host.bounds.size.width;
+    CGFloat hostH = host.bounds.size.height;
+    if (hostW < 1 || hostH < 1) {
+        return;
+    }
+    // WhatsApp-style self-view: larger portrait tile over remote (top-leading).
+    CGFloat insetW = hostW * 0.42;
+    CGFloat insetH = insetW * (16.0 / 9.0);
+    if (insetH > hostH * 0.38) {
+        insetH = hostH * 0.38;
+        insetW = insetH * (9.0 / 16.0);
+    }
+    CGFloat margin = MAX(8.0, hostW * 0.05);
+    _localInsetContainer.frame = CGRectMake(margin, margin, insetW, insetH);
+    _localSampleView.frame = _localInsetContainer.bounds;
+    [_localSampleView requestScaleRecalculation];
+}
+
+- (void)ensureLocalInsetViews {
+    if (_localInsetContainer) {
+        return;
+    }
+    _localInsetContainer = [[UIView alloc] initWithFrame:CGRectZero];
+    _localInsetContainer.clipsToBounds = YES;
+    _localInsetContainer.layer.cornerRadius = 10;
+    _localInsetContainer.layer.borderWidth = 1.5;
+    _localInsetContainer.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.45].CGColor;
+    _localInsetContainer.backgroundColor = [UIColor clearColor];
+    _localInsetContainer.hidden = YES;
+
+    _localSampleView = [[SampleBufferVideoCallView alloc] initWithFrame:CGRectZero];
+    _localSampleView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    // Same fill path as remote PiP (Aspect + upright scale) — no letterbox, no AspectFill zoom.
+    _localSampleView.fitForInset = NO;
+    _localSampleView.sampleBufferLayer.videoGravity = AVLayerVideoGravityResizeAspect;
+    _localSampleView.clipsToBounds = YES;
+    [_localInsetContainer addSubview:_localSampleView];
+    [_pipCallViewController.view addSubview:_localInsetContainer];
+    [self layoutLocalInset];
+}
