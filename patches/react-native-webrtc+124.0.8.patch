+/**
+ * Safe shutdown before RTCView unmount / stream null on call end.
+ * Avoids AVKit crashes from releasing an active PiP controller.
+ */
+- (void)prepareForTeardown {
+    _placeholderActive = NO;
+    _sampleView.shouldRender = NO;
+    _localSampleView.shouldRender = NO;
+    if (_videoTrack) {
+        [_videoTrack removeRenderer:_sampleView];
+        _videoTrack = nil;
+    }
+    if (_localVideoTrack) {
+        [_localVideoTrack removeRenderer:_localSampleView];
+        _localVideoTrack = nil;
+    }
+    if (_pipController.isPictureInPictureActive || _pipController.isPictureInPicturePossible) {
+        [_pipController stopPictureInPicture];
+    }
+    _pipController.delegate = nil;
+    // Drop content source so AVKit cannot keep a live reference into this view tree.
+    if (@available(iOS 15.0, *)) {
+        _pipController.contentSource = nil;
+    }
+    _contentSource = nil;
+}
+
+- (void)onAlaznahPrepareTeardown:(NSNotification *)notification {
