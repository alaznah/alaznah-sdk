<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#052e16"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

  <TextView
      android:id="@+id/rnc_incoming_subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="48dp"
      android:text="Incoming call"
      android:textColor="#bbf7d0"
      android:textSize="16sp" />

  <TextView
      android:id="@+id/rnc_incoming_caller"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="Caller"
      android:textColor="#ffffff"
      android:textSize="36sp"
      android:textStyle="bold" />

  <View
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_weight="1" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="48dp"
      android:gravity="center"
      android:orientation="horizontal">

    <Button
        android:id="@+id/rnc_decline"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:backgroundTint="#b91c1c"
        android:text="Decline"
        android:textAllCaps="false"
        android:textColor="#ffffff"
        android:textSize="18sp" />

    <Button
        android:id="@+id/rnc_accept"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:backgroundTint="#15803d"
        android:text="Accept"
        android:textAllCaps="false"
        android:textColor="#ffffff"
        android:textSize="18sp" />
  </LinearLayout>
</LinearLayout>
